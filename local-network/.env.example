# eth_simulateV1 Test Network Configuration
# Copy this file to .env and customize as needed

# Docker Compose Project Name
COMPOSE_PROJECT_NAME=eth-simulatev1-testnet

# Network Configuration
CHAIN_ID=1337
NETWORK_NAME=eth_testnet

# Execution Client Images
OPGETH_IMAGE=ghcr.io/unitsnetwork/op-geth:v1.101603.0-1
OPRETH_IMAGE=ghcr.io/unitsnetwork/op-reth:simulate-v1-1.0.0

# Consensus Client Images
LIGHTHOUSE_IMAGE=sigp/lighthouse:v5.2.1
PRYSM_IMAGE=gcr.io/prysmaticlabs/prysm/beacon-chain:v5.1.0

# Ports Configuration
# op-geth
OPGETH_RPC_PORT=18545
OPGETH_WS_PORT=18546
OPGETH_ENGINE_PORT=18551
OPGETH_P2P_PORT=30303

# op-reth
OPRETH_RPC_PORT=28545
OPRETH_WS_PORT=28546
OPRETH_ENGINE_PORT=28551
OPRETH_P2P_PORT=30304

# Lighthouse
LIGHTHOUSE_API_PORT=15052
LIGHTHOUSE_P2P_PORT=9000

# Prysm
PRYSM_API_PORT=14000
PRYSM_GRPC_PORT=13500
PRYSM_P2P_TCP_PORT=13000
PRYSM_P2P_UDP_PORT=12000

# Validator Configuration
VALIDATOR_COUNT=4
MIN_GENESIS_TIME=1704067200

# Chain Parameters
SECONDS_PER_SLOT=12
SLOTS_PER_EPOCH=32

# Logging
LOG_LEVEL=info
LOG_MAX_SIZE=1g
LOG_MAX_FILES=5

# Resource Limits (optional - uncomment if needed)
#MEMORY_LIMIT=4g
#CPU_LIMIT=2.0

# Test Configuration
TEST_TIMEOUT=30
TEST_RETRIES=3
